      <data key="d4">unknown_source</data>
      <data key="d5">1748752715</data>
    </node>
    <node id="设计方面">
      <data key="d0">设计方面</data>
      <data key="d1">category</data>
      <data key="d2">Design considerations include material selection, component layout, and application of new technologies to reduce internal stress and deformation during manufacturing.</data>
      <data key="d3">chunk-8aca48788ebf46b14f234652a9c385da</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1748752715</data>
    </node>
    <node id="制造方面">
      <data key="d0">制造方面</data>
      <data key="d1">category</data>
      <data key="d2">Manufacturing considerations involve reducing residual stress in the stock and implementing processes to eliminate internal stress during and after machining.</data>
      <data key="d3">chunk-8aca48788ebf46b14f234652a9c385da</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1748752715</data>
