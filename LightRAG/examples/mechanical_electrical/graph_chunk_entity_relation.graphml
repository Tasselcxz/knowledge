      <data key="d0">点蚀磨损</data>
      <data key="d1">category</data>
      <data key="d2">Pitting wear is a type of wear characterized by small holes or pits on the surface of a material caused by the interaction of hard particles.</data>
      <data key="d3">chunk-60f29046f6ed7b64daf3284ca274d836</data>
      <data key="d4">unknown_source</data>
