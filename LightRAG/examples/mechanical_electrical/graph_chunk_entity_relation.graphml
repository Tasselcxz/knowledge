      <data key="d1">category</data>
      <data key="d2">棉纱是用于擦拭和清理机械设备中油孔的工具。</data>
      <data key="d3">chunk-89c33b1709aba69300fa32c8a1899f2e</data>
      <data key="d4">unknown_source</data>
