    <node id="日常维护">
      <data key="d0">日常维护</data>
      <data key="d1">category</data>
      <data key="d2">Daily maintenance is carried out by operators to ensure equipment is in good technical condition.&lt;SEP&gt;Regular maintenance of equipment to prevent issues.</data>
