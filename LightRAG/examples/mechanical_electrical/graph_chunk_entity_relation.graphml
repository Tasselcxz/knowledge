      <data key="d11">1748752834</data>
    </edge>
    <edge source="电镀修复技术" target="修复">
      <data key="d6">9.0</data>
      <data key="d7">电镀修复技术是修复零件的一种方法，通过在零件表面形成金属镀层来修复磨损后的尺寸和改善表面质量。</data>
      <data key="d8">修复方法,电镀应用</data>
      <data key="d9">chunk-5cec839b9f36b19446104b0ebb382214</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1748752834</data>
    </edge>
    <edge source="修复" target="热喷涂修复技术">
      <data key="d6">7.0</data>
      <data key="d7">热喷涂修复技术是修复技术中的一种，用于在基体表面形成特殊的工作表面，以达到防腐、耐磨等功能。</data>
      <data key="d8">修复方法,热喷涂应用</data>
      <data key="d9">chunk-5cec839b9f36b19446104b0ebb382214</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1748752834</data>
    </edge>
    <edge source="修复" target="喷焊修复技术">
      <data key="d6">8.0</data>
      <data key="d7">喷焊修复技术是修复技术中的一种，通过熔融喷涂层和工件基体表面形成冶金结合，以改善和提高零件表面性能。</data>
      <data key="d8">修复方法,喷焊应用</data>
      <data key="d9">chunk-5cec839b9f36b19446104b0ebb382214</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1748752834</data>
    </edge>
    <edge source="绝缘" target="短路">
      <data key="d6">7.0</data>
      <data key="d7">绝缘损坏可能导致短路，影响电动机运行。</data>
