    <node id="设备维修计划">
      <data key="d0">设备维修计划</data>
      <data key="d1">category</data>
      <data key="d2">Equipment maintenance plans include annual, quarterly, and monthly plans for various types of repairs and regular maintenance and equipment installation, tailored to the specific needs of the enterprise.</data>
