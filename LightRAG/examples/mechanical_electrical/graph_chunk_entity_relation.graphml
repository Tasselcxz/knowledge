    </node>
    <node id="弹性变形">
      <data key="d0">弹性变形</data>
      <data key="d1">category</data>
      <data key="d2">弹性变形是指外力去除后，零件能够完全恢复原状的变形。</data>
      <data key="d3">chunk-b9aa1cf69ef2f507f89adeb826f8b153</data>
      <data key="d4">unknown_source</data>
