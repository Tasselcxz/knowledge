    <node id="自动线">
      <data key="d0">自动线</data>
      <data key="d1">category</data>
      <data key="d2">An assembly line that automates the production process.&lt;SEP&gt;Automated line refers to a system of machinery that operates without human intervention to produce goods.</data>
