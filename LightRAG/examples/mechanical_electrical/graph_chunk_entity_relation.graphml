      <data key="d0">胶合磨损</data>
      <data key="d1">category</data>
      <data key="d2">Adhesive wear is a type of wear caused by the bonding of two surfaces and the subsequent removal of material from one or both surfaces.</data>
      <data key="d3">chunk-60f29046f6ed7b64daf3284ca274d836</data>
      <data key="d4">unknown_source</data>
