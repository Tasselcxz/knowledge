    <node id="垫片和套">
      <data key="d0">垫片和套</data>
      <data key="d1">category</data>
      <data key="d2">Shims and sleeves used in the assembly process, which must meet specific quality requirements and are not to be used unless specified in the assembly drawings.</data>
