      <data key="d5">1748752708</data>
    </node>
    <node id="腐蚀介质">
      <data key="d0">腐蚀介质</data>
      <data key="d1">category</data>
      <data key="d2">Corrosion medium is the environment in which the corrosion process occurs, such as gases, liquids, or soil.&lt;SEP&gt;腐蚀介质是指能够引起金属腐蚀的化学物质。&lt;SEP&gt;腐蚀介质是指能引起金属材料发生腐蚀的物质。</data>
      <data key="d3">chunk-b9aa1cf69ef2f507f89adeb826f8b153&lt;SEP&gt;chunk-512a577252da2b6701f9a8656b72a4ab&lt;SEP&gt;chunk-03f1d70a27d38bd5958000f010d50574</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1748752708</data>
    </node>
