      <data key="d4">unknown_source</data>
      <data key="d5">1748752732</data>
    </node>
    <node id="修复工艺措施">
      <data key="d0">修复工艺措施</data>
      <data key="d1">category</data>
      <data key="d2">Repair process measures are techniques used to restore the functionality of damaged mechanical components, aiming to eliminate failures efficiently.</data>
      <data key="d3">chunk-a9e974b3af6506d86c1cfa2d59bfd0fa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1748752732</data>
    </node>
    <node id="修复技术">
      <data key="d0">修复技术</data>
      <data key="d1">category</data>
      <data key="d2">Repair techniques are methods used to restore the functionality of worn or damaged machinery parts.&lt;SEP&gt;Repair technologies are methods employed to repair damaged components, considering factors like material compatibility and repair layer thickness.</data>
      <data key="d3">chunk-a9e974b3af6506d86c1cfa2d59bfd0fa&lt;SEP&gt;chunk-f2714adef57ebf31098afe9ba8240006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1748752732</data>
    </node>
    <node id="修复层">
      <data key="d0">修复层</data>
      <data key="d1">category</data>
      <data key="d2">A layer applied to repair parts, which needs to be of a certain thickness and have good mechanical properties.&lt;SEP&gt;Repair layers are coatings or fillings applied to restore the functionality of damaged components, with considerations for their mechanical properties and bond strength.&lt;SEP&gt;修复层是指在修复过程中形成的金属层。</data>
      <data key="d3">chunk-5cec839b9f36b19446104b0ebb382214&lt;SEP&gt;chunk-a9e974b3af6506d86c1cfa2d59bfd0fa&lt;SEP&gt;chunk-f2714adef57ebf31098afe9ba8240006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1748752732</data>
    </node>
    <node id="装配">
      <data key="d0">装配</data>
      <data key="d1">event</data>
      <data key="d2">The process of assembling gears and other mechanical components to ensure they function correctly and efficiently.&lt;SEP&gt;The process of assembling parts together in the text.&lt;SEP&gt;The process of assembly involves checking the shape and size accuracy of parts before assembly to ensure they meet requirements.</data>
      <data key="d3">chunk-7717f9c647b8d45b1cefa44db848f23a&lt;SEP&gt;chunk-9faeed8bfe22cedda2f9a100d7b556bb&lt;SEP&gt;chunk-a9e974b3af6506d86c1cfa2d59bfd0fa</data>
      <data key="d4">unknown_source</data>
