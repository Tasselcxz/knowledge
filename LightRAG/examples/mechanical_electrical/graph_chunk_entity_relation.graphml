      <data key="d4">unknown_source</data>
      <data key="d5">1748752732</data>
    </node>
    <node id="检查间隔期">
      <data key="d0">检查间隔期</data>
      <data key="d1">category</data>
      <data key="d2">The inspection interval is the working time between two consecutive inspections or between inspections and repairs for machine equipment.</data>
      <data key="d3">chunk-04cea29d26cccba82114b00118a166e9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1748752732</data>
