      <data key="d0">维修劳动量定额</data>
      <data key="d1">category</data>
      <data key="d2">The maintenance labor quantity standard is the labor time required for various types of machine equipment repairs, usually represented by the working hours required for one maintenance complexity coefficient.</data>
      <data key="d3">chunk-04cea29d26cccba82114b00118a166e9</data>
      <data key="d4">unknown_source</data>
