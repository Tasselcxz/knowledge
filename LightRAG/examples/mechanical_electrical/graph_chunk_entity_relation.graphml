      <data key="d1">category</data>
      <data key="d2">精度是指设备或产品达到预定标准的能力。</data>
      <data key="d3">chunk-1e246e13c7735682855bcf3af1c7da37</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1748752711</data>
    </node>
    <node id="性能">
