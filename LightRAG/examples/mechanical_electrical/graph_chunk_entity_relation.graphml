      <data key="d0">平面磨床</data>
      <data key="d1">category</data>
      <data key="d2">A machine tool used for precision grinding and finishing flat surfaces of workpieces.&lt;SEP&gt;A machine tool used for the precision grinding of flat surfaces on workpieces.</data>
      <data key="d3">chunk-ec89303a6088293925f758d2cbbf49ab&lt;SEP&gt;chunk-67175ab18c23c1816a4f561e5a5d372b</data>
      <data key="d4">unknown_source</data>
