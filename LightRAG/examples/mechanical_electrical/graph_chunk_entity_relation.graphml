      <data key="d0">计划预防维修</data>
      <data key="d1">category</data>
      <data key="d2">Preventive maintenance planning is an approach that targets specific types of repair for monitored equipment.</data>
      <data key="d3">chunk-867a4342f2d363853256548ad11eb4d5</data>
      <data key="d4">unknown_source</data>
