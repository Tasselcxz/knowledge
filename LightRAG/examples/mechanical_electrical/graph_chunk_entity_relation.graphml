    </edge>
    <edge source="齿轮" target="轮齿折断">
      <data key="d6">8.0</data>
      <data key="d7">Gear failure includes tooth fracture, which can occur due to various reasons such as fatigue and overload.</data>
      <data key="d8">failure mechanism,gear operation</data>
      <data key="d9">chunk-76f8d626c0daad789485fb4b40abae42</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1748752834</data>
    </edge>
    <edge source="齿轮" target="点蚀">
      <data key="d6">7.0</data>
      <data key="d7">Gear failure includes pitting, which occurs due to cyclic stress and lubrication issues in closed-gear drives.</data>
      <data key="d8">gear design,lubrication,stress</data>
      <data key="d9">chunk-76f8d626c0daad789485fb4b40abae42</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1748752834</data>
    </edge>
    <edge source="齿轮" target="齿面胶合">
      <data key="d6">6.0</data>
      <data key="d7">Gear failure includes bonding failure, where the metal of the meshing teeth adheres under pressure and then wears off.</data>
      <data key="d8">contact stress,gear load</data>
      <data key="d9">chunk-76f8d626c0daad789485fb4b40abae42</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1748752834</data>
    </edge>
    <edge source="齿轮" target="齿面磨损">
      <data key="d6">9.0</data>
      <data key="d7">Gear failure includes surface wear, which can be abrasive wear in open gears and running-in wear under light loads.</data>
      <data key="d8">gear operation,wear mechanism</data>
      <data key="d9">chunk-76f8d626c0daad789485fb4b40abae42</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1748752834</data>
    </edge>
    <edge source="齿轮" target="齿面塑性变形">
      <data key="d6">7.0</data>
      <data key="d7">Gear failure includes plastic deformation, which can occur in soft gear materials under heavy loads or friction.</data>
      <data key="d8">gear design,material stress</data>
      <data key="d9">chunk-76f8d626c0daad789485fb4b40abae42</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1748752834</data>
    </edge>
    <edge source="齿轮" target="齿轮运动准确性">
      <data key="d6">8.0</data>
      <data key="d7">Gears are used to control the movement accuracy of gears, making the method simple and easy to implement in production.</data>
      <data key="d8">accuracy,control,production method</data>
