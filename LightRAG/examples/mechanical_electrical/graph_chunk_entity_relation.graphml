      <data key="d4">unknown_source</data>
      <data key="d5">1748752715</data>
    </node>
    <node id="气泡爆破">
      <data key="d0">气泡爆破</data>
      <data key="d1">category</data>
      <data key="d2">气泡爆破是指气泡在高压区破裂的现象。</data>
