    <node id="压力机">
      <data key="d0">压力机</data>
      <data key="d1">category</data>
      <data key="d2">A machine used to apply force to materials, often for forming or shaping purposes, such as in the removal of bearings.&lt;SEP&gt;Machine used to apply force to parts, often used in the removal of tight-fitting components in machinery.</data>
      <data key="d3">chunk-a9e974b3af6506d86c1cfa2d59bfd0fa&lt;SEP&gt;chunk-45ba06ce22ee19f5d752b6523954299d</data>
